{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dependencyDashboardTitle": "Renovate Dependency Dashboard",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)apps/.+\\.ya?ml$/",
      "/(^|/)infrastructure/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)apps/.+\\.ya?ml$/",
      "/(^|/)infrastructure/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Group Kubernetes CSI sidecar image bumps",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.k8s.io/sig-storage/**"
      ],
      "groupName": "csi sidecars"
    },
    {
      "description": "Pin mutable image tags to a digest so we track what actually ships",
      "matchDatasources": [
        "docker"
      ],
      "matchCurrentValue": "/^(latest|main|stable.*)$/",
      "pinDigests": true
    },
    {
      "description": "Auto-merge digest-only updates for already-pinned mutable tags. Renovate merges these itself: the repo has no status checks, so ignoreTests is needed (Renovate otherwise waits for checks that never run), and GitHub's platform auto-merge is off in the repo settings.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": true
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/(^|/)clusters/.+\\.ya?ml$/"
    ]
  }
}
